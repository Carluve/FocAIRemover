# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored).
# Never commit real keys.

# Optional: require Authorization: Bearer <this> on /api (except /api/health).
# API_KEY=

# Local watermarks-remover HTTP service (docker compose).
CLEANER_URL=http://127.0.0.1:8765

# Optional bearer the Worker sends to the cleaner (WATERMARKS_SERVER_API_KEY).
# WATERMARKS_SERVER_API_KEY=
