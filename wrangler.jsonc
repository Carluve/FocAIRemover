// FocAIRemover — Workers config.
// Cloudflare account: carluve @enterprise (NOT personal).
// Enterprise: 39f8ea10b94ad38470fc3c20c260efdc
// Do not use personal: 052a5feff6731a169b7012425b020cc5
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focairemover",
  "main": "apps/worker/src/index.ts",
  "account_id": "39f8ea10b94ad38470fc3c20c260efdc",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    // Only /api/* needs the Worker. `true` billed a Worker invocation for every
    // static asset and sent them all through the API router for nothing.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Public origin allowlist for CORS. Same-origin (this Worker) is always allowed.
    // Never "*". Override locally in .dev.vars if needed.
    "ALLOWED_ORIGIN": "https://focairemover.carluve.workers.dev",
    // 8 MiB. The cleaner contract is base64-in-JSON, so N bytes cost ~3.7N of
    // isolate memory against the 128 MB limit; 32 MiB peaked near the ceiling.
    "MAX_UPLOAD_BYTES": "8388608",
    // Must stay under the 30s ctx.waitUntil() budget when CLEAN_QUEUE is unbound.
    "CLEANER_TIMEOUT_MS": "20000",
    // JSON forwarded as `options` to watermarks-remover /clean. Empty = Layer A
    // only, which is what this project claims to do. Upstream makes Layer B
    // MANDATORY for the `text` kind, so plain .txt fails until you set a
    // strategy here AND configure a rewrite backend on the cleaner — which
    // sends user text to a model. .md/.html/images/PDF need nothing here.
    "CLEANER_OPTIONS": "",
    // ANONYMOUS ACCESS. "true" serves /api/upload and /api/jobs with no bearer
    // token, which is what the bundled drag-drop UI needs — it cannot hold a
    // secret. Anyone can then upload and spend R2 on this account; the rate
    // limiter below is the only brake. Set "false" and `wrangler secret put
    // API_KEY` for an API-client-only deploy. Never leave this unset-and-open
    // by accident: unset + no API_KEY now returns 503, not an open door.
    "PUBLIC_UPLOADS": "true",
    // Turnstile. The sitekey is public and is served to the UI via /api/health;
    // the secret is a Worker secret (`wrangler secret put TURNSTILE_SECRET`).
    // Verification is a no-op until the secret exists, so local dev and tests
    // are unaffected. Fill the sitekey in after creating the widget.
    "TURNSTILE_SITEKEY": "",
    // Hostnames siteverify must report back. Production only — never list
    // localhost here, or a token minted on a dev box would be accepted.
    "TURNSTILE_HOSTNAMES": "focairemover.carluve.workers.dev",
  },
  "r2_buckets": [
    {
      "binding": "FOCAI_FILES",
      "bucket_name": "focairemover-files",
    },
  ],
  "d1_databases": [
    {
      "binding": "JOBS",
      "database_name": "focairemover-jobs",
      "database_id": "d7d7154b-3a79-4bee-ae2f-c0f74e6b69aa",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Unique per this app on the enterprise account. Do not reuse 1001.
      "namespace_id": "904201",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],

  // Durable job processing. Without this block the Worker falls back to
  // ctx.waitUntil(), which dies with the isolate and strands jobs in
  // `processing`. Enable with two commands, then uncomment:
  //
  //   npx wrangler queues create focairemover-clean-dlq
  //   npx wrangler queues create focairemover-clean
  //
  // "queues": {
  //   "producers": [
  //     { "binding": "CLEAN_QUEUE", "queue": "focairemover-clean" }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "focairemover-clean",
  //       "max_batch_size": 1,
  //       "max_batch_timeout": 5,
  //       "max_retries": 3,
  //       "dead_letter_queue": "focairemover-clean-dlq"
  //     }
  //   ]
  // },

  // Cloudflare Containers: wrangler deploy builds containers/cleaner/Dockerfile
  // (FROM ghcr.io/guillaumemeyer/watermarks-remover) and pushes to the
  // enterprise Cloudflare registry. Requires Docker locally for that deploy.
  // Local `wrangler dev` without Docker: set CLEANER_URL in .dev.vars
  // (docker compose up -f docker-compose.yml).
  //
  // Uncomment to attach the container on deploy:
  // "containers": [
  //   {
  //     "class_name": "CleanerContainer",
  //     "image": "./containers/cleaner/Dockerfile",
  //     "max_instances": 3,
  //     "instance_type": "basic"
  //   }
  // ],
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "CLEANER", "class_name": "CleanerContainer" }
  //   ]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["CleanerContainer"] }
  // ]
}
