{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    // Tests import source modules by their explicit .ts path.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    // @cloudflare/vitest-plugin/types declares the `cloudflare:test` module.
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "apps/worker/src/**/*.ts",
    "worker-configuration.d.ts",
    "env.d.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
