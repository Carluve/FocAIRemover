{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    // Tests run through `node --experimental-strip-types`, which requires the
    // explicit .ts extension on relative imports.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/worker/src/**/*.ts", "worker-configuration.d.ts", "env.d.ts", "tests/**/*.ts"]
}
