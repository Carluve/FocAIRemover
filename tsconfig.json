{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `npm test` runs the sources directly under Node, which needs explicit
    // extensions on relative imports.
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/worker/src/**/*.ts", "worker-configuration.d.ts", "env.d.ts", "tests/**/*.ts"]
}
